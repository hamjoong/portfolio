# DevCodeHub 백엔드 환경변수 목록 (값은 비워 둔 예시입니다)
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채웁니다. .env 는 Git에 올리지 않습니다.
# 값이 있는 항목은 기본값입니다. 비워 두면 해당 기능이 꺼지거나 기동이 실패합니다.

# ── 필수: 데이터베이스 (Postgres) ──
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ── 필수: 인증 ──
# JWT 서명 키: 32자(256bit) 이상의 무작위 문자열
JWT_SECRET=
JWT_EXPIRATION=
# 최초 기동 시 만들어지는 관리자 계정
ADMIN_ID=
ADMIN_PASSWORD=

# ── 주소 / CORS ──
# 프론트엔드 공개 주소 (CORS·웹소켓·소셜 로그인 후 이동에 사용)
FRONTEND_URL=
CORS_ALLOWED_ORIGIN=
# prod 프로필 전용: 백엔드 공개 주소 (소셜 로그인 redirect URI, 업로드 URL 기본값)
BACKEND_URL=

# ── 소셜 로그인 (OAuth2) — 쓰는 제공자만 채우면 됩니다 ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=

# ── AI 코드 리뷰 — 키가 비어 있는 모델은 화면에서 '키 미등록'으로 비활성화됩니다 ──
GEMINI_API_KEY=
GEMINI_MODEL=
CLAUDE_API_KEY=
CLAUDE_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ── 결제 (PortOne 테스트 결제) ──
PORTONE_V2_STORE_ID=
PORTONE_V2_API_SECRET=
PORTONE_V1_API_KEY=
PORTONE_V1_API_SECRET=

# ── 파일 업로드 ──
# local 프로필: 서버 디스크(uploads/profiles/)에 저장
# prod 프로필: Supabase Storage 에 저장
APP_UPLOAD_BASE_URL=
STORAGE_BUCKET=
SUPABASE_S3_ENDPOINT_HOST=
SUPABASE_SERVICE_ROLE_KEY=

# ── Redis (선택): 켜면 채팅 메시지를 여러 서버 인스턴스에 전달합니다. 끄면 단일 서버로 동작 ──
REDIS_AUTO_STARTUP=false
REDIS_HOST=localhost
REDIS_PORT=6379
